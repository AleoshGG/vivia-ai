# === General ===
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# === Autenticación ===
INTERNAL_API_KEY=changeme-super-secret-key
# JWT del servicio LLM (mismo secret con el que el backend transaccional firma los tokens
# del móvil). HS512 requiere un secret de al menos 64 bytes.
JWT_SECRET=changeme-jwt-secret-of-at-least-64-bytes-for-hs512-change-me-now!
JWT_ALGORITHM=HS512

# === Google Cloud Storage ===
GCS_BUCKET_NAME=vivia-ai-data-lake
# GCS_CREDENTIALS_PATH=./credentials/gcs-service-account.json

# === RabbitMQ ===
RABBITMQ_HOST=vivia-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=vivia
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/

# === MLflow ===
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=gs://vivia-ai-data-lake/mlflow-artifacts
ANOMALY_MODEL_NAME=anomaly
ANOMALY_MODEL_STAGE=Production

# === PostgreSQL ===
# Backend de inferencias del servicio de anomalías y backend-store de MLflow.
POSTGRES_USER=vivia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vivia
# URL asíncrona usada por la app (asyncpg). El host 'vivia-postgres' es el del contenedor.
DATABASE_URL=postgresql+asyncpg://vivia:changeme@vivia-postgres:5432/vivia
# URL síncrona usada por el backend-store de MLflow.
MLFLOW_BACKEND_STORE_URI=postgresql://vivia:changeme@vivia-postgres:5432/vivia

# === Model Registry (artefactos locales) ===
# Ruta en el HOST con los artefactos del modelo (.joblib/.json) que se monta
# como volumen en el contenedor. En el VPS apúntala a una carpeta persistente
# fuera del repo. En local, déjala comentada para usar ./models_registry.
# MODELS_REGISTRY_HOST=/srv/vivia/models_registry

# === Servicios ===
ANOMALY_API_PORT=8001
CLUSTERING_SERVICE_PORT=8002
LLM_LOCAL_PORT=8003

# === LLM Local Service ===
# URL del contenedor llama-server (backend de inferencia del servicio LLM).
LLAMA_SERVER_URL=http://llama-server:8080
LLM_MODEL_NAME=llm-listing-generator
LLM_MODEL_STAGE=Production
LLM_GGUF_FILE=Qwen3-1.7B-Q4_K_M.gguf
# Backend transaccional (Spring): usado para verificar GET /subscriptions/me
# antes de generar título/descripción (gating premium, fail-closed).
VIVIA_BACKEND_URL=https://vivia.aleosh.online/api
SUBSCRIPTIONS_CHECK_TIMEOUT=5.0

# === Análisis de texto (servicio de anomalías) ===
# Reusa LLAMA_SERVER_URL como backend (Qwen3 zero-shot binario fraude/limpio).
# TEXT_RISK_ENABLED=false opera solo con reglas si el llama-server no está.
TEXT_RISK_ENABLED=true
TEXT_RISK_TIMEOUT=30.0
TEXT_RISK_MAX_TOKENS=400
