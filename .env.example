# === General ===
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# === Autenticación ===
INTERNAL_API_KEY=changeme-super-secret-key

# === Google Cloud Storage ===
GCS_BUCKET_NAME=vivia-ai-data-lake
# GCS_CREDENTIALS_PATH=./credentials/gcs-service-account.json

# === RabbitMQ ===
RABBITMQ_HOST=vivia-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=vivia
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/

# === MLflow ===
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=gs://vivia-ai-data-lake/mlflow-artifacts

# === Servicios ===
ANOMALY_API_PORT=8001
CLUSTERING_SERVICE_PORT=8002
LLM_LOCAL_PORT=8003
